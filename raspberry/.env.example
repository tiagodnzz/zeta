# Copie este arquivo para .env e preencha apenas o que precisar.

# IA: groq usa a API remota; ollama usa o modelo local.
ZETA_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=1
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=medium
ZETA_AI_TIMEOUT_S=30

# Configuracao alternativa do Ollama.
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_S=180
OLLAMA_START_TIMEOUT_S=15

# Voz e painel web.
ZETA_TTS_ENABLED=1
ZETA_TTS_LENGTH_SCALE=1.05
ZETA_TTS_NOISE_SCALE=0.75
ZETA_TTS_NOISE_W=0.85

# Transcricao: Groq e mais rapida; use local para voltar ao Whisper no Raspberry.
ZETA_TRANSCRIPTION_PROVIDER=groq
ZETA_GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
ZETA_GROQ_TRANSCRIPTION_TEMPERATURE=0

# Whisper: beam 1 reduz a latencia sem trocar o modelo small.
ZETA_WHISPER_BEAM_SIZE=1

# Token opcional do Hugging Face para baixar o modelo Whisper com limites maiores.
HF_TOKEN=
ZETA_WEB_HOST=0.0.0.0
ZETA_WEB_PORT=8080
ZETA_MENU_NAVIGATION=pointer
ZETA_MENU_DWELL_TIME_S=1.5
