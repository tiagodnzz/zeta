# Copie este arquivo para .env e preencha apenas o que precisar.

# IA: groq usa a API remota; ollama usa o modelo local.
ZETA_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=1
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=medium
ZETA_AI_TIMEOUT_S=30

# Configuracao alternativa do Ollama.
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_S=180
OLLAMA_START_TIMEOUT_S=15

# Voz e painel web.
ZETA_TTS_ENABLED=1
ZETA_TTS_LENGTH_SCALE=0.95
ZETA_TTS_NOISE_SCALE=0.667
ZETA_TTS_NOISE_W=0.8
ZETA_WHISPER_MODEL=small
ZETA_WHISPER_DEVICE=cpu
ZETA_WHISPER_COMPUTE_TYPE=int8
ZETA_WHISPER_BEAM_SIZE=5
ZETA_WEB_HOST=0.0.0.0
ZETA_WEB_PORT=8080